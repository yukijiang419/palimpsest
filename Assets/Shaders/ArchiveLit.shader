Shader "Caffeine/Archive Lit"
{
    // Material controls exposed in Unity's Inspector. The first group mirrors
    // Unity's Standard shader so existing materials retain their textures and
    // values when they are changed to this shader.
    Properties
    {
        // Standard-compatible names preserve existing material data.
        _MainTex ("Albedo", 2D) = "white" {}
        _Color ("Color", Color) = (1, 1, 1, 1)
        [Normal] _BumpMap ("Normal Map", 2D) = "bump" {}
        _BumpScale ("Normal Strength", Range(0, 2)) = 1
        _Metallic ("Metallic", Range(0, 1)) = 0
        _Glossiness ("Smoothness", Range(0, 1)) = 0.35
        _MetallicGlossMap ("Metallic (R), Smoothness (A)", 2D) = "white" {}
        _GlossMapScale ("Smoothness map scale", Range(0,1)) = 1
        _UseSurfaceMask ("Use surface mask", Range(0,1)) = 0
        _WorldUV ("World XZ projection", Range(0,1)) = 0
        _WorldScale ("Repeats per metre", Float) = .5
        _OcclusionMap ("Occlusion", 2D) = "white" {}
        _OcclusionStrength ("Occlusion Strength", Range(0, 1)) = 1
        _EmissionMap ("Emission", 2D) = "white" {}
        [HDR] _EmissionColor ("Emission Color", Color) = (0, 0, 0, 0)

        // Shared future-archive lighting treatment.
        [HDR] _AmbientColor ("Ambient Fill", Color) = (0.035, 0.055, 0.09, 1)
        _AmbientStrength ("Ambient Fill Strength", Range(0, 1)) = 0.22
        [HDR] _TopLightColor ("Top Light", Color) = (0.42, 0.58, 0.72, 1)
        _TopLightStrength ("Top Light Strength", Range(0, 1)) = 0.1
        [HDR] _RimColor ("Archive Rim", Color) = (0.12, 0.68, 0.9, 1)
        _RimStrength ("Rim Strength", Range(0, 2)) = 0.16
        _RimPower ("Rim Tightness", Range(0.5, 8)) = 3.5
    }

    SubShader
    {
        // Render with opaque geometry and participate in the normal depth pass.
        Tags { "RenderType"="Opaque" "Queue"="Geometry" }
        LOD 300

        // Handwritten forward pass. It performs every vertex transformation,
        // texture sample, normal conversion, and lighting calculation directly.
        Pass
        {
            Name "FORWARD"
            Tags { "LightMode"="ForwardBase" }

            CGPROGRAM
            // Explicit entry points satisfy the assessed vertex/fragment
            // requirement; no Surface Shader code is generated by Unity.
            #pragma target 3.0
            #pragma vertex vert
            #pragma fragment frag

            // Compile variants for baked lightmaps, real-time shadows, fog,
            // and GPU instancing on supported platforms.
            #pragma multi_compile_fwdbase
            #pragma multi_compile_fog
            #pragma multi_compile_instancing

            #include "UnityCG.cginc"
            #include "Lighting.cginc"
            #include "AutoLight.cginc"

            // Texture transform values (_ST) contain the tiling and offset set
            // in each material's Inspector.
            sampler2D _MainTex;
            float4 _MainTex_ST;
            sampler2D _BumpMap;
            float4 _BumpMap_ST;
            sampler2D _OcclusionMap;
            float4 _OcclusionMap_ST;
            sampler2D _EmissionMap;
            float4 _EmissionMap_ST;
            sampler2D _MetallicGlossMap;
            float4 _MetallicGlossMap_ST;
            half _GlossMapScale, _UseSurfaceMask, _WorldUV;
            float _WorldScale;

            fixed4 _Color;
            fixed4 _EmissionColor;
            fixed4 _AmbientColor;
            fixed4 _TopLightColor;
            fixed4 _RimColor;
            half _BumpScale;
            half _Metallic;
            half _Glossiness;
            half _OcclusionStrength;
            half _AmbientStrength;
            half _TopLightStrength;
            half _RimStrength;
            half _RimPower;

            struct AppData
            {
                // Position, normal, tangent, and primary UV come from the mesh.
                // TEXCOORD1 contains Unity's secondary lightmap UV unwrap.
                float4 vertex : POSITION;
                float3 normal : NORMAL;
                float4 tangent : TANGENT;
                float2 uv : TEXCOORD0;
                float2 lightmapUV : TEXCOORD1;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct VertexToFragment
            {
                // SV_POSITION drives rasterisation. Unity's shadow-transfer
                // macro expects this conventional clip-space field name.
                float4 pos : SV_POSITION;
                float2 albedoUV : TEXCOORD0;
                float2 normalUV : TEXCOORD1;
                float2 occlusionUV : TEXCOORD2;
                float2 emissionUV : TEXCOORD3;
                float3 worldPosition : TEXCOORD4;
                half3 worldNormal : TEXCOORD5;
                half3 worldTangent : TEXCOORD6;
                half3 worldBitangent : TEXCOORD7;
                float2 lightmapUV : TEXCOORD8;
                SHADOW_COORDS(9)
                UNITY_FOG_COORDS(10)
                UNITY_VERTEX_INPUT_INSTANCE_ID
                UNITY_VERTEX_OUTPUT_STEREO
            };

            VertexToFragment vert(AppData input)
            {
                VertexToFragment output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_INITIALIZE_OUTPUT(VertexToFragment, output);
                UNITY_TRANSFER_INSTANCE_ID(input, output);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);

                // Transform the vertex and tangent basis from object space into
                // world space. Tangent handedness corrects mirrored transforms.
                output.pos = UnityObjectToClipPos(input.vertex);
                output.worldPosition = mul(unity_ObjectToWorld, input.vertex).xyz;
                output.worldNormal = UnityObjectToWorldNormal(input.normal);
                output.worldTangent = UnityObjectToWorldDir(input.tangent.xyz);
                output.worldBitangent = cross(output.worldNormal, output.worldTangent)
                    * (input.tangent.w * unity_WorldTransformParams.w);

                // Apply each texture's independent material tiling and offset.
                output.albedoUV = TRANSFORM_TEX(input.uv, _MainTex);
                output.normalUV = TRANSFORM_TEX(input.uv, _BumpMap);
                output.occlusionUV = TRANSFORM_TEX(input.uv, _OcclusionMap);
                output.emissionUV = TRANSFORM_TEX(input.uv, _EmissionMap);
                float2 worldUV = output.worldPosition.xz * _WorldScale;
                output.albedoUV = lerp(output.albedoUV, worldUV, _WorldUV);
                output.normalUV = lerp(output.normalUV, worldUV, _WorldUV);
                output.occlusionUV = lerp(output.occlusionUV, worldUV, _WorldUV);

                // Convert authored secondary UVs into the current lightmap atlas.
                output.lightmapUV = input.lightmapUV * unity_LightmapST.xy + unity_LightmapST.zw;
                TRANSFER_SHADOW(output);
                UNITY_TRANSFER_FOG(output, output.pos);
                return output;
            }

            fixed4 frag(VertexToFragment input) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(input);

                // Sample and tint the material's base colour.
                fixed4 albedoSample = tex2D(_MainTex, input.albedoUV) * _Color;

                // Decode the tangent-space normal map. Scaling X and Y changes
                // perceived bump strength before the vector is renormalised.
                half3 normalTS = UnpackNormal(tex2D(_BumpMap, input.normalUV));
                normalTS.xy *= _BumpScale;
                normalTS = normalize(normalTS);

                // Form a tangent-to-world matrix from the interpolated mesh
                // basis, then rotate the mapped normal into world space.
                half3 normalWS = normalize(
                    normalize(input.worldTangent) * normalTS.x
                    + normalize(input.worldBitangent) * normalTS.y
                    + normalize(input.worldNormal) * normalTS.z);

                half3 lightDirection = normalize(UnityWorldSpaceLightDir(input.worldPosition));
                half3 viewDirection = normalize(UnityWorldSpaceViewDir(input.worldPosition));
                half3 halfDirection = normalize(lightDirection + viewDirection);
                half nDotL = saturate(dot(normalWS, lightDirection));
                UNITY_LIGHT_ATTENUATION(attenuation, input, input.worldPosition);

                // Static geometry reads indirect illumination from baked
                // lightmaps. Dynamic objects use spherical-harmonic light probes.
                half3 indirectLight;
                #ifdef LIGHTMAP_ON
                    indirectLight = DecodeLightmap(UNITY_SAMPLE_TEX2D(unity_Lightmap, input.lightmapUV));
                #else
                    indirectLight = ShadeSH9(half4(normalWS, 1.0));
                #endif

                // Green-channel ambient occlusion darkens indirect light while
                // preserving the principal light's direct visibility.
                half sampledOcclusion = tex2D(_OcclusionMap, input.occlusionUV).g;
                half occlusion = lerp(1.0, sampledOcclusion, _OcclusionStrength);
                half3 directDiffuse = _LightColor0.rgb * nDotL * attenuation;

                // Approximate a metallic Blinn-Phong response. Smoothness maps
                // to highlight width, while metallic blends the F0 colour from
                // dielectric grey toward the surface albedo.
                half smoothness = lerp(_Glossiness, tex2D(_MetallicGlossMap, input.albedoUV).a * _GlossMapScale, _UseSurfaceMask);
                half specularPower = lerp(8.0, 128.0, smoothness);
                half specularTerm = pow(saturate(dot(normalWS, halfDirection)), specularPower);
                half3 specularColor = lerp(0.04.xxx, albedoSample.rgb, _Metallic);
                half3 specular = specularColor * _LightColor0.rgb * specularTerm
                    * nDotL * attenuation;
                half3 diffuseColor = albedoSample.rgb * (1.0 - _Metallic);
                half3 litSurface = diffuseColor * (indirectLight * occlusion + directDiffuse) + specular;

                // Upward-facing normals receive a cool top light. This is a
                // hemispherical stylisation rather than a physical point light.
                half upward = saturate(normalWS.y * 0.5 + 0.5);
                half3 ambientFill = _AmbientColor.rgb * _AmbientStrength;
                half3 topLight = _TopLightColor.rgb * upward * _TopLightStrength;

                // Fresnel-style rim intensity increases toward grazing angles.
                // The power controls rim tightness and strength controls energy.
                half rim = pow(1.0 - saturate(dot(normalWS, viewDirection)), _RimPower);
                half3 archiveRim = _RimColor.rgb * rim * _RimStrength;

                // Authored emission plus stylised fills remain visible in shadow
                // and establish the game's cool temporal-archive atmosphere.
                half3 materialEmission = tex2D(_EmissionMap, input.emissionUV).rgb
                    * _EmissionColor.rgb;
                half3 finalColor = litSurface + materialEmission + ambientFill + topLight + archiveRim;

                fixed4 outputColor = fixed4(finalColor, albedoSample.a);
                UNITY_APPLY_FOG(input.fogCoord, outputColor);
                return outputColor;
            }
            ENDCG
        }

        // Explicit shadow-caster pass writes opaque object depth from the
        // light's viewpoint so Archive Lit materials cast real-time shadows.
        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode"="ShadowCaster" }

            CGPROGRAM
            #pragma target 3.0
            #pragma vertex vertShadow
            #pragma fragment fragShadow
            #pragma multi_compile_shadowcaster
            #pragma multi_compile_instancing

            #include "UnityCG.cginc"

            struct ShadowAppData
            {
                float4 vertex : POSITION;
                float3 normal : NORMAL;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct ShadowInterpolators
            {
                V2F_SHADOW_CASTER;
                UNITY_VERTEX_OUTPUT_STEREO
            };

            ShadowInterpolators vertShadow(ShadowAppData input)
            {
                ShadowInterpolators output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_INITIALIZE_OUTPUT(ShadowInterpolators, output);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);

                // Unity applies normal offset and depth bias to reduce common
                // shadow acne artifacts before writing the shadow-map position.
                float4 positionCS = UnityClipSpaceShadowCasterPos(input.vertex, input.normal);
                output.pos = UnityApplyLinearShadowBias(positionCS);
                return output;
            }

            float4 fragShadow(ShadowInterpolators input) : SV_Target
            {
                SHADOW_CASTER_FRAGMENT(input)
            }
            ENDCG
        }
    }
    FallBack "Standard"
}
